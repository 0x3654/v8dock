// Managed form module of the «Получение лицензии» (License Acquisition) external data processor.
//
// Purpose: programmatic acquisition/renewal of the community license (the
// developer license) via the platform's standard API (ПолучениеЛицензий, available since 8.3.20).
// The hardware fingerprint is taken from the machine where the code runs — launch
// it in a session on the target server (in the lic1c stand: ibsrv + thin client /Execute).
//
// Parameters are passed via the file /home/usr1cv8/license-params.txt:
//     login===password          — license "for all users" (/var/1C/licenses)
//     login===password===client — license for the current user only
//     empty/no file             — renewal attempt without credentials
// Progress is written to /home/usr1cv8/license-result.txt (read by license-renew.sh).
// Build the epf from this file: python3 scripts/build-epf.py (v8unpack -BUILD).

&НаСервере
Функция Вып()
	П = ПолучениеЛицензий.ПолучитьПараметрыПривязкиККомпьютеру();
	Попытка
		Возврат XMLСтрока(П);
	Исключение
		Возврат "ТИП: " + ТипЗнч(П) + " / " + Строка(П);
	КонецПопытки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазобратьСтрокуПараметров(Знач СтрокаПараметров)
	Результат = Новый Структура("Логин, Пароль, ДляВсех", "", "", Истина);
	Части = СтрРазделить(СтрокаПараметров, "===", Ложь);
	Если Части.Количество() >= 1 Тогда
		Результат.Логин = СокрЛП(Части[0]);
	КонецЕсли;
	Если Части.Количество() >= 2 Тогда
		Результат.Пароль = СокрЛП(Части[1]);
	КонецЕсли;
	Если Части.Количество() >= 3 И ВРег(СокрЛП(Части[2])) = "КЛИЕНТ" Тогда
		Результат.ДляВсех = Ложь;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаписатьРезультат(Текст)
	Попытка
		Запись = Новый ЗаписьТекста("/home/usr1cv8/license-result.txt", КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьФайлПараметров()
	Путь = "/home/usr1cv8/license-params.txt";
	Файл = Новый Файл(Путь);
	Если Не Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Строка = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат СокрЛП(Строка);
КонецФункции

&НаСервере
Процедура ПолучитьЛицензию(Логин, Пароль, ДляВсех)
	Запрос = Новый ЗапросНаПолучениеЛицензии;
	Запрос.ПараметрыПривязки    = ПолучениеЛицензий.ПолучитьПараметрыПривязкиККомпьютеру();
	Запрос.ПорталРазработчиков  = "developer.1c.ru";  // string: "" | developer.1c.ru | 1c-dn.com
	Запрос.ИмяУчетнойЗаписи     = Логин;
	Запрос.ПарольУчетнойЗаписи  = Пароль;
	Запрос.ДляВсехПользователей = ДляВсех;

	Если ПустаяСтрока(Логин) Тогда
		// RENEWAL without credentials: the center renews the existing license,
		// recognizing it by request time/file name (name format: YYYYMMDDHHMMSS.lic)
		ПоследнийФайл = "";
		Для Каждого Ф Из НайтиФайлы("/var/1C/licenses/*.lic") Цикл
			Если Ф.ИмяБезРасширения > ПоследнийФайл Тогда
				ПоследнийФайл = Ф.ИмяБезРасширения;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(ПоследнийФайл) = 14 Тогда
			Запрос.ВремяЗапроса = Дата(
				Число(Сред(ПоследнийФайл, 1, 4)), Число(Сред(ПоследнийФайл, 5, 2)),
				Число(Сред(ПоследнийФайл, 7, 2)), Число(Сред(ПоследнийФайл, 9, 2)),
				Число(Сред(ПоследнийФайл, 11, 2)), Число(Сред(ПоследнийФайл, 13, 2)));
			Запрос.ИмяФайлаЛицензии = ПоследнийФайл + ".lic";
		КонецЕсли;
	Иначе
		// acquisition WITH credentials: if the license already exists — this is an
		// in-place RENEWAL (credentials + recognition by file name/issue time, no
		// slot taken; without recognition the center honestly asks for a new slot —
		// on 06.09 we got «превышено количество активных лицензий»). If there is
		// no license — initial acquisition (takes a slot).
		ПоследнийФайл = "";
		Для Каждого Ф Из НайтиФайлы("/var/1C/licenses/*.lic") Цикл
			Если Ф.ИмяБезРасширения > ПоследнийФайл Тогда
				ПоследнийФайл = Ф.ИмяБезРасширения;
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(ПоследнийФайл) = 14 Тогда
			Запрос.ВремяЗапроса = Дата(
				Число(Сред(ПоследнийФайл, 1, 4)), Число(Сред(ПоследнийФайл, 5, 2)),
				Число(Сред(ПоследнийФайл, 7, 2)), Число(Сред(ПоследнийФайл, 9, 2)),
				Число(Сред(ПоследнийФайл, 11, 2)), Число(Сред(ПоследнийФайл, 13, 2)));
			Запрос.ИмяФайлаЛицензии = ПоследнийФайл + ".lic";
		Иначе
			Запрос.ВремяЗапроса = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЕсли;

	ПолучениеЛицензий.ПолучитьЛицензиюАвтоматически(Запрос);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаписатьРезультат("START " + Формат(ТекущаяДата(), "ДЛФ=T"));
	Попытка
		П = РазобратьСтрокуПараметров(ПрочитатьФайлПараметров());
		// DUMP: diagnostic mode — fingerprint without contacting the center
		Если ВРег(П.Логин) = "DUMP" Тогда
			ЗаписатьРезультат("DUMP:" + Символы.ПС + Вып());
			ЗавершитьРаботуСистемы(Ложь);
			Возврат;
		КонецЕсли;
		ЗаписатьРезультат("PARAMS OK, Логин=""" + П.Логин + """, ДляВсех=" + Формат(П.ДляВсех, "БЛ=Ложь; ИИ=Истина"));
		ПолучитьЛицензию(П.Логин, П.Пароль, П.ДляВсех);
		ЗаписатьРезультат("LICENSE OK " + Формат(ТекущаяДата(), "ДЛФ=T"));
	Исключение
		ЗаписатьРезультат("ERROR: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры
