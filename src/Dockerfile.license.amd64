# syntax=docker/dockerfile:1
# 1C license activation/renewal stand — the amd64 variant UNDER ROSETTA.
#
# Why not arm64 (contrary to the stand's "native" style): (1) the server license
# is bound to the VirtualApple x86 fingerprint (see the pitfalls in the README) —
# renewal must originate from the same fingerprint; (2) the 1C arm64 client
# segfaults during GUI initialization under Docker Desktop 4.89 (VM of 31.08.2026).
# The stand is a one-off (a run once every 7 days), the emulation layer is not
# on the hot path.
#
# A copy of src/Dockerfile.license with amd64 paths (/opt/1cv8/x86_64) and the
# lic1c-base:11-amd64 base (debian:11 — webkit 4.0/libsoup2, build: the sed
# trick from Dockerfile.base, see src/scripts/build.sh).
FROM docker.io/0x3654/lic1c-base:latest AS unpack

ARG CLIENT_DEB=1c-enterprise-8.3.27.2325-client_8.3.27-2325_amd64.deb
ARG COMMON_DEB=1c-enterprise-8.3.27.2325-common_8.3.27-2325_amd64.deb
# the server deb is mandatory: the /F thick client brings up the server context
ARG SERVER_DEB=1c-enterprise-8.3.27.2325-server_8.3.27-2325_amd64.deb

RUN --mount=type=bind,source=dists,target=/dists set -eux; \
    dpkg-deb -x "/dists/${COMMON_DEB}" /out; \
    dpkg-deb -x "/dists/${CLIENT_DEB}" /out; \
    dpkg-deb -x "/dists/${SERVER_DEB}" /out; \
    rm -f /out/opt/1cv8/x86_64/*/libwx_gtk3u*.wk41

FROM docker.io/0x3654/lic1c-base:latest

ARG SERVER_VERSION=8.3.27.2325

LABEL org.opencontainers.image.title="1C license stand ${SERVER_VERSION} (amd64/Rosetta)" \
      org.opencontainers.image.description="Thick client under Xvfb/VNC; runs the license-renew.sh epf automaton" \
      org.opencontainers.image.version="${SERVER_VERSION}"

COPY --from=unpack /out/opt/1cv8 /opt/1cv8

# entrypoint after the heavy COPY: editing the script does not invalidate the cache
COPY src/entrypoints/license-entrypoint.sh /usr/local/bin/

# uid/gid hardcoded to the server volume owner (usr1cv8:grp1cv8 = 999:1000):
# the platform calls getpwnam and segfaults silently without the user
RUN groupadd -g 1000 grp1cv8 && \
    useradd -o -u 999 -g 1000 -d /home/usr1cv8 -s /usr/sbin/nologin usr1cv8

ENV LANG=ru_RU.UTF-8 \
    PATH=/opt/1cv8/x86_64/${SERVER_VERSION}:$PATH \
    DISPLAY=:0

ENTRYPOINT ["license-entrypoint.sh"]
