# Only the needed files get into the build context (~1.5 GB of extra files sit in dists/).
# Patterns — for ANY platform version (see src/scripts/build-server.sh).
dists/*
!dists/postgresql_*_aarch64_package.tar.bz2
!dists/postgresql_*_deb_tar.bz2
!dists/1c-enterprise-*-common_*.deb
!dists/1c-enterprise-*-server_*.deb
!dists/1c-enterprise-*-client_*_arm64.deb
!dists/1c-enterprise-*-client_*_amd64.deb
!dists/1c-enterprise82-*_amd64.deb

.env
README.md

# not needed in the build context
src/mac/
src/win/
src/backup/
src/scripts/
src/license-epf/
