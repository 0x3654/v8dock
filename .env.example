# postgres superuser password (created on first cluster initialization)
POSTGRES_PASSWORD=меняй-меня

# developer.1c.ru account for obtaining/renewing the 1C server community license
# (used by license-renew.sh in first mode)
DEV_LICENSE_LOGIN=
DEV_LICENSE_PASSWORD=

# host directory for the nightly pg dumps (mounted into pg1c as /backups;
# read by docker-compose.yml and src/backup/pg-backup.sh). Relative paths
# resolve against the repo root. Default if unset: ~/pg1c-backups
#PG_BACKUP_DIR=./data/backups
