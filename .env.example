# postgres superuser password (created on first cluster initialization)
POSTGRES_PASSWORD=меняй-меня

# developer.1c.ru account for obtaining/renewing the 1C server community license
# (used by license-renew.sh in first mode)
DEV_LICENSE_LOGIN=
DEV_LICENSE_PASSWORD=

# releases.1c.ru account for downloading platform distributions
# (src/scripts/fetch-release.py). Must have download access; DEV_LICENSE_*
# above is used as a fallback (it logs in but sees no files)
RELEASES_LOGIN=
RELEASES_PASSWORD=

# host directory for the nightly pg dumps (mounted into pg1c as /backups;
# read by docker-compose.yml and src/backup/pg-backup.sh). Relative paths
# resolve against the repo root. Default if unset: ~/pg1c-backups
#PG_BACKUP_DIR=./data/backups

# Backup retention (GFS): see per-contour settings above

# Deployment profile: test (demo databases) | dev (development databases, see pg1c-dev)
PG_PROFILE=test

# Which databases belong to which contour (for backups; currently in one
# cluster pg1c — when pg1c-dev appears they move there). Space-separated
# names of YOUR databases — fill in from your own stand.
TEST_DATABASES="erp_demo trade_demo"
DEV_DATABASES=""

# Backup retention per contour
# TEST: demo bases, restored from distributions — thin GFS
BACKUP_KEEP_DAILY=3
BACKUP_KEEP_WEEKLY=2
BACKUP_KEEP_MONTHLY=1
# DEV: development bases (your working copies) — denser GFS
DEV_BACKUP_KEEP_DAILY=7
DEV_BACKUP_KEEP_WEEKLY=4
DEV_BACKUP_KEEP_MONTHLY=3

# DEV контур (задел на будущее, раскомментировать с pg1c-dev):
# DEV_PG_BACKUP_DIR=/path/to/dev-backups
# DEV_BACKUP_KEEP_DAILY=3
# DEV_BACKUP_KEEP_WEEKLY=2
# DEV_BACKUP_KEEP_MONTHLY=1
# DEV_ARCHIVE_TIMEOUT=900   # 15-min RPO (PITR)
